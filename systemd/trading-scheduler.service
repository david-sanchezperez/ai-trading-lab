[Unit]
Description=AI Trading Lab — Market Scheduler
After=network.target ibgateway.service
Wants=ibgateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=david
WorkingDirectory=/home/david/code/ai-trading-lab
EnvironmentFile=/home/david/code/ai-trading-lab/.env
ExecStart=/home/david/code/ai-trading-lab/.venv/bin/python3 -m scheduler.market_scheduler
Restart=always
RestartSec=60
StandardOutput=append:/var/log/trading/scheduler.log
StandardError=append:/var/log/trading/scheduler.log
SyslogIdentifier=trading-scheduler

[Install]
WantedBy=multi-user.target
